# ============================================
# DIGIXITO ENVIRONMENT CONFIGURATION
# ============================================

# Resend API Key for sending contact form inquiries
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where new inbound leads should be delivered
# Defaults to info@digixito.com if left blank
CONTACT_EMAIL=info@digixito.com

# Verified sender email address in Resend (e.g. contact@digixito.com)
# For testing with free tier before domain verification, use onboarding@resend.dev
FROM_EMAIL=Digixito Inquiries <onboarding@resend.dev>
